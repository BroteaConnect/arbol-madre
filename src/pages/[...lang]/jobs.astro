---
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { alternates, dirOf, fmtDate, localePath, localePaths, stripLocale, t } from '../../lib/i18n';
import { instantOf, leafItems } from '../../lib/jobs.js';
import '../../styles/theme.css';
// Load-bearing: the canvas colours live here, not in the generated theme.
import '../../styles/tree-palette.css';

// One file, every language: /jobs (es) and /en/jobs.
export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const i18nPath = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);

// El Árbol del Empleo — brotea.dev
// The second tree: every LEAF is a job offer, every limb the company that
// published it. Offers are curated data (src/data/jobs.json); the merge of
// that file is the act of publishing. Expired offers are dropped here, at
// build time, and again in the browser — a static build ages.
const offers = leafItems(locale, Date.now());
const companies = new Set(offers.map((o) => o.company)).size;
// `instantOf` pins a plain date to midday UTC so it never slips a day in the
// reader's zone — and keeps `fmtDate` off an unformattable string.
const day = (iso: string) => fmtDate(locale, instantOf(iso));
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(locale, 'jobs.page.title')}</title>
    <meta name="description" content={t(locale, 'jobs.page.description')} />
    {alternates(i18nPath).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath('es', i18nPath))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
    <script is:inline defer id="brotea-errors" src="/brotea-errors.js" data-dsn={import.meta.env.PUBLIC_GLITCHTIP_DSN}></script>
  </head>
  <body>
    <canvas id="jobs-tree" aria-label={t(locale, 'jobs.aria')}></canvas>

    <header>
      <p class="wordmark">brotea<span>.dev</span></p>
      <h1>{t(locale, 'jobs.title')}</h1>
      <p class="tagline">{t(locale, 'jobs.tagline')}</p>
      <p class="stats" id="jobs-stats" aria-live="polite">
        {t(locale, 'jobs.stats.summary', { offers: offers.length, companies })}
      </p>
      <nav class="crosslink">
        <a href={localePath(locale, '/')}>{t(locale, 'nav.tree')}</a>
      </nav>
      <div class="switcher"><LanguageSwitcher locale={locale} /></div>
    </header>

    <aside id="job-card" aria-live="polite">
      <button id="job-card-close" aria-label={t(locale, 'jobs.card.close')}>×</button>
      <h2 id="job-card-title"></h2>
      <p class="meta" id="job-card-company"></p>
      <p class="chips">
        <span class="chip" id="job-card-modality"></span>
        <span class="chip" id="job-card-contract"></span>
        <span class="chip" id="job-card-seniority"></span>
        <span class="chip plain" id="job-card-location"></span>
      </p>
      <p class="summary" id="job-card-summary"></p>
      <p class="dates">
        <span id="job-card-published"></span>
        <span id="job-card-expires"></span>
      </p>
      <nav class="links">
        <a id="job-card-url" target="_blank" rel="noopener noreferrer nofollow" class="primary">{t(locale, 'jobs.apply')}</a>
      </nav>
    </aside>

    <!-- Rendered at build time on purpose: the offers are readable, crawlable
         and applicable with JavaScript switched off. The canvas is the second
         way to read the same list, never the only one. -->
    <section class="offers" aria-label={t(locale, 'jobs.list.aria')}>
      <h2 id="offer-count">{t(locale, 'jobs.offers', { count: offers.length })}</h2>
      <p id="offers-empty" class:list={['empty', offers.length === 0 && 'shown']}>
        {t(locale, 'jobs.empty')}
      </p>
      <ul id="offer-list">
        {offers.map((o) => (
          <!-- The DOM id is namespaced `leaf-`: a curated offer id like
               `job-card` would otherwise shadow this page's own elements and
               break the card wiring. `leaf-` is a prefix no element here uses
               (`offer-` would still collide with #offer-list / #offer-count).
               The deep link stays the bare offer id; lookups go via data-id. -->
          <li id={`leaf-${o.id}`} data-id={o.id} data-tone={o.tone} data-expires={o.expires_at ?? ''}>
            <a class="offer-title" href={`#${o.id}`}>{o.title}</a>
            <p class="offer-company">{t(locale, 'jobs.card.company', { company: o.companyName })}</p>
            <p class="offer-chips">
              <span class="chip">{t(locale, `jobs.modality.${o.modality}`)}</span>
              <span class="chip">{t(locale, `jobs.contract.${o.contract}`)}</span>
              {o.seniority && <span class="chip">{t(locale, `jobs.seniority.${o.seniority}`)}</span>}
              {o.location && <span class="chip plain">{o.location}</span>}
            </p>
            <p class="offer-summary">{o.summary}</p>
            <p class="offer-dates">
              {t(locale, 'jobs.card.published', { date: day(o.published_at) })}
              {o.expires_at ? ` · ${t(locale, 'jobs.card.expires', { date: day(o.expires_at) })}` : ''}
            </p>
            {o.url && (
              <a class="offer-apply" href={o.url} target="_blank" rel="noopener noreferrer nofollow">
                {t(locale, 'jobs.apply')}
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <ul class="legend" aria-label={t(locale, 'jobs.legend.aria')}>
        <li><i class="dot fresh"></i> {t(locale, 'jobs.legend.fresh')}</li>
        <li><i class="dot open"></i> {t(locale, 'jobs.legend.open')}</li>
        <li><i class="dot closing"></i> {t(locale, 'jobs.legend.closing')}</li>
      </ul>
      <p class="credit">{t(locale, 'credit')}</p>
    </footer>

    <style>
      /* Sizes come from clamp()/min() and one literal breakpoint on purpose:
         a media query can NOT read a custom property, so `@media (max-width:
         var(--container))` is dropped whole by every browser. */
      #jobs-tree { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }

      /* The panels float over the canvas, so they let clicks through and each
         interactive child takes them back. Forgetting the `auto` is how a link
         ends up dead with a perfectly green build. */
      header {
        position: fixed; top: 1.4rem; left: 1.6rem; max-width: min(20rem, calc(100vw - 3.2rem));
        pointer-events: none;
      }
      .wordmark {
        margin: 0; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em;
        color: var(--accent);
      }
      .wordmark span { color: var(--muted); font-weight: 600; }
      h1 {
        margin: 0.4rem 0 0.15rem; font-size: clamp(1.5rem, 4vw, 2.3rem);
        font-weight: 800; letter-spacing: -0.02em; line-height: 1.05;
      }
      .tagline { margin: 0; color: var(--ink-2); font-size: 1rem; }
      .stats {
        margin: 0.7rem 0 0; font-size: 0.82rem; color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .crosslink { margin: 0.5rem 0 0; }
      .crosslink a {
        pointer-events: auto;
        display: inline-block; font-size: 0.85rem; font-weight: 650;
        color: var(--accent); text-decoration: none;
        padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: 99px;
        background: var(--surface);
      }
      .crosslink a:hover { border-color: var(--accent); }
      .switcher { pointer-events: auto; margin-top: 0.35rem; }

      /* --halo/--ink rather than --accent/white: both flip with the colour
         scheme, so the chip keeps ~9:1 contrast by day and by night. */
      .chip {
        display: inline-block; padding: 0.1rem 0.55rem; border-radius: 99px;
        background: var(--halo); color: var(--ink); font-size: 0.75rem; font-weight: 650;
      }
      .chip.plain { background: transparent; color: var(--muted); border: 1px solid var(--line); }
      .chip.hidden { display: none; }

      #job-card {
        position: fixed; top: 1.4rem; right: 1.4rem; width: min(21rem, calc(100vw - 2.8rem));
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
        padding: 1.1rem 1.2rem; backdrop-filter: blur(8px);
        transform: translateX(calc(100% + 2rem)); transition: transform 0.25s ease;
        pointer-events: none;
      }
      #job-card.open { transform: none; pointer-events: auto; }
      @media (prefers-reduced-motion: reduce) { #job-card { transition: none; } }
      #job-card h2 { margin: 0 2rem 0.3rem 0; font-size: 1.1rem; letter-spacing: -0.01em; }
      #job-card .meta { margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--ink-2); }
      #job-card .chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0 0 0.6rem; }
      #job-card .summary { margin: 0 0 0.6rem; font-size: 0.88rem; color: var(--ink-2); line-height: 1.45; }
      /* --ink-2, not --muted: dates are content and this size of text needs
         more than the 3.7:1 --muted gives on a light surface. */
      #job-card .dates {
        margin: 0 0 0.8rem; font-size: 0.78rem; color: var(--ink-2);
        display: flex; flex-wrap: wrap; gap: 0.4rem;
      }
      #job-card .links a {
        display: block; padding: 0.55rem 0.75rem; border-radius: var(--radius); font-size: 0.88rem;
        text-align: center; text-decoration: none; font-weight: 650;
        background: var(--accent); color: var(--on-accent);
      }
      /* Beats the `display: block` above — see the note in showCard(). */
      #job-card .links a.hidden { display: none; }
      #job-card-close {
        position: absolute; top: 0.55rem; right: 0.7rem; border: 0; background: none;
        font-size: 1.3rem; line-height: 1; color: var(--muted); cursor: pointer; padding: 0.2rem;
      }

      .offers {
        position: fixed; left: 1.6rem; bottom: 3.4rem; pointer-events: auto;
        width: min(23rem, calc(100vw - 3.2rem));
        max-height: min(52vh, 30rem); overflow-y: auto;
        background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius-lg); padding: 0.9rem 1rem;
        backdrop-filter: blur(8px);
      }
      .offers h2 { margin: 0 0 0.6rem; font-size: 0.9rem; color: var(--ink-2); letter-spacing: -0.01em; }
      .offers .empty { display: none; margin: 0; font-size: 0.85rem; color: var(--muted); }
      .offers .empty.shown { display: block; }
      #offer-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
      #offer-list li { display: grid; gap: 0.25rem; padding-left: 0.6rem; border-left: 3px solid var(--leaf); }
      #offer-list li[data-tone='fresh'] { border-left-color: var(--job-fresh); }
      #offer-list li[data-tone='closing'] { border-left-color: var(--job-closing); }
      /* Expired since the build: hidden with a class, never with [hidden] —
         any author `display` rule would win over the attribute. */
      #offer-list li.expired { display: none; }
      .offer-title {
        font-weight: 700; font-size: 0.95rem; color: var(--ink); text-decoration: none;
        letter-spacing: -0.01em;
      }
      .offer-title:hover { color: var(--accent); }
      .offer-company { margin: 0; font-size: 0.8rem; color: var(--ink-2); }
      .offer-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.15rem 0; }
      .offer-summary { margin: 0; font-size: 0.82rem; color: var(--ink-2); line-height: 1.45; }
      .offer-dates { margin: 0; font-size: 0.75rem; color: var(--ink-2); }
      .offer-apply { font-size: 0.8rem; font-weight: 650; color: var(--accent); text-decoration: none; }
      .offer-apply:hover { text-decoration: underline; }

      footer {
        position: fixed; left: 1.6rem; right: 1.6rem; bottom: 1rem;
        display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem;
        pointer-events: none; flex-wrap: wrap;
      }
      .legend { list-style: none; display: flex; gap: 1.1rem; margin: 0; padding: 0; flex-wrap: wrap; }
      .legend li { font-size: 0.78rem; color: var(--muted); display: flex; align-items: center; gap: 0.4rem; }
      .dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; display: inline-block; }
      .dot.fresh { background: var(--job-fresh); box-shadow: 0 0 8px var(--halo); }
      .dot.open { background: var(--job-open); }
      .dot.closing { background: var(--job-closing); }
      .credit { margin: 0; font-size: 0.78rem; color: var(--muted); }

      @media (max-width: 720px) {
        header { max-width: min(15rem, calc(100vw - 3.2rem)); }
        .offers {
          left: 0.8rem; right: 0.8rem; width: auto; bottom: 2.8rem;
          max-height: 40vh;
        }
        #job-card { top: auto; bottom: 2.8rem; right: 0.8rem; width: min(21rem, calc(100vw - 1.6rem)); }
        footer { left: 0.8rem; right: 0.8rem; bottom: 0.5rem; }
        .credit { display: none; }
      }
    </style>

    <script>
      import { createTree } from '../../lib/tree.js';
      import { JOB_SPECIES, instantOf, leafItems } from '../../lib/jobs.js';
      import { DEFAULT_LOCALE, fmtDate, isLocale, t } from '../../lib/i18n';

      // Astro ships ONE bundle for every route, so the language is read from
      // the <html lang> the page rendered with.
      const htmlLang = document.documentElement.lang;
      const locale = isLocale(htmlLang) ? htmlLang : DEFAULT_LOCALE;
      const _ = (key: string, vars?: Record<string, string | number>) => t(locale, key, vars);
      const day = (iso: string) => fmtDate(locale, instantOf(iso));

      const card = document.getElementById('job-card');
      const $ = (id: string) => document.getElementById(id);
      type Offer = ReturnType<typeof leafItems>[number];
      let offers: Offer[] = [];

      function chip(id: string, text: string) {
        const el = $(id);
        el.textContent = text ?? '';
        el.classList.toggle('hidden', !text);
      }

      function showCard(o: Offer | null) {
        if (!o) { card.classList.remove('open'); return; }
        $('job-card-title').textContent = o.title;
        $('job-card-company').textContent = _('jobs.card.company', { company: o.companyName });
        chip('job-card-modality', _(`jobs.modality.${o.modality}`));
        chip('job-card-contract', _(`jobs.contract.${o.contract}`));
        chip('job-card-seniority', o.seniority ? _(`jobs.seniority.${o.seniority}`) : '');
        chip('job-card-location', o.location ?? '');
        $('job-card-summary').textContent = o.summary;
        $('job-card-published').textContent = _('jobs.card.published', { date: day(o.published_at) });
        $('job-card-expires').textContent = o.expires_at
          ? `· ${_('jobs.card.expires', { date: day(o.expires_at) })}`
          : '';
        // `leafItems` nulls a non-https link rather than pass it on; without a
        // destination the button is hidden, not left pointing nowhere. Hidden
        // with a class: `#job-card .links a` sets `display: block`, which would
        // win over the [hidden] attribute.
        const apply = $('job-card-url') as HTMLAnchorElement;
        apply.classList.toggle('hidden', !o.url);
        if (o.url) apply.href = o.url;
        else apply.removeAttribute('href');
        card.classList.add('open');
        history.replaceState(null, '', `#${o.id}`);
      }

      function closeCard() {
        showCard(null);
        tree.select(null);
        history.replaceState(null, '', location.pathname);
      }
      $('job-card-close').addEventListener('click', closeCard);

      const tree = createTree(document.getElementById('jobs-tree'), {
        species: JOB_SPECIES,
        onSelect: showCard,
      });

      /**
       * Re-read the offers with the visitor's clock. The page was rendered
       * when it was built, which may have been weeks ago: without this, an
       * expired offer keeps hanging on the tree and in the list forever.
       */
      function refresh() {
        offers = leafItems(locale, Date.now());
        tree.setData(offers);
        const companies = new Set(offers.map((o) => o.company)).size;
        $('jobs-stats').textContent = _('jobs.stats.summary', { offers: offers.length, companies });
        $('offer-count').textContent = _('jobs.offers', { count: offers.length });
        $('offers-empty').classList.toggle('shown', offers.length === 0);
        // A Map, not a Set: the tone decays too (open → closing), and a green
        // border next to an amber leaf makes the legend lie.
        const live = new Map(offers.map((o) => [o.id, o]));
        for (const li of document.querySelectorAll<HTMLLIElement>('#offer-list > li')) {
          const o = live.get(li.dataset.id ?? '');
          li.classList.toggle('expired', !o);
          if (o) li.dataset.tone = o.tone;
        }
        // An offer that expired while the tab sat open: close its card and drop
        // the hash, or a reload silently lands on a link that opens nothing.
        if (card.classList.contains('open') && !live.has(location.hash.slice(1))) closeCard();
      }

      function openFromHash() {
        const id = location.hash.slice(1);
        if (!id) return;
        const o = offers.find((x) => x.id === id);
        if (o) { tree.select(o.id); showCard(o); return; }
        // A shared link to an offer that has since closed: don't leave a hash
        // that does nothing on every reload.
        history.replaceState(null, '', location.pathname);
      }
      addEventListener('hashchange', openFromHash);

      // Clicking a title in the list opens the same card the leaf opens.
      $('offer-list').addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a.offer-title');
        if (!link) return;
        e.preventDefault();
        const id = link.closest<HTMLLIElement>('li')?.dataset.id;
        const o = offers.find((x) => x.id === id);
        if (o) { tree.select(o.id); showCard(o); }
      });

      refresh();
      openFromHash();
      // A tab left open across the expiry date should notice.
      setInterval(refresh, 15 * 60 * 1000);
    </script>
  </body>
</html>
