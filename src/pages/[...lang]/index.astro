---
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { alternates, dirOf, localePath, localePaths, stripLocale, t } from '../../lib/i18n';
import '../../styles/theme.css';
// The canvas palette lives here so /jobs can grow the same tree — see the
// header of tree-palette.css. Order matters: after theme.css.
import '../../styles/tree-palette.css';

// One file, every language: / (es) and /en/.
export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const i18nPath = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
// El Árbol Madre — brotea.dev
// One living organism: every fruit is a real project of the Brotea factory,
// updated from the events stream. Built by the factory itself.
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(locale, 'page.title')}</title>
    <meta name="description" content={t(locale, 'page.description')} />
    {alternates(i18nPath).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath('es', i18nPath))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
      <script is:inline defer id="brotea-errors" src="/brotea-errors.js" data-dsn={import.meta.env.PUBLIC_GLITCHTIP_DSN}></script>
  </head>
  <body>
    <canvas id="tree" aria-label={t(locale, 'tree.aria')}></canvas>

    <header>
      <p class="wordmark">brotea<span>.dev</span></p>
      <h1>{t(locale, 'hero.title')}</h1>
      <p class="tagline">{t(locale, 'hero.tagline')}</p>
      <p class="stats" id="stats" aria-live="polite">{t(locale, 'stats.loading')}</p>
      <nav class="crosslink">
        <a href={localePath(locale, '/jobs')}>{t(locale, 'nav.jobs')}</a>
      </nav>
      <LanguageSwitcher locale={locale} />
    </header>

    <aside id="card" aria-live="polite">
      <button id="card-close" aria-label={t(locale, 'card.close')}>×</button>
      <h2 id="card-name"></h2>
      <p class="meta"><span id="card-status" class="chip"></span> <span id="card-creator"></span></p>
      <p class="counts" id="card-counts"></p>
      <nav class="links">
        <a id="card-url" target="_blank" rel="noopener" class="primary">{t(locale, 'card.visit')}</a>
        <a id="card-repo" target="_blank" rel="noopener">{t(locale, 'card.repo')}</a>
        <a id="card-topic" target="_blank" rel="noopener">{t(locale, 'card.topic')}</a>
      </nav>
    </aside>

    <footer>
      <ul class="legend" aria-label={t(locale, 'legend.aria')}>
        <li><i class="dot bud"></i> {t(locale, 'legend.bud')}</li>
        <li><i class="dot blossom"></i> {t(locale, 'legend.blossom')}</li>
        <li><i class="dot green"></i> {t(locale, 'legend.green')}</li>
        <li><i class="dot ripe"></i> {t(locale, 'legend.ripe')}</li>
      </ul>
      <p class="credit">{t(locale, 'credit')}</p>
    </footer>

    <!-- The colour palette and the page shell (reset, body background) moved
         to src/styles/tree-palette.css, imported above, so the job tree reads
         exactly the same greens. -->
    <style>
      #tree { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }

      header { position: fixed; top: 1.4rem; left: 1.6rem; max-width: 20rem; pointer-events: none; }
      .wordmark {
        margin: 0; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em;
        color: var(--accent);
      }
      .wordmark span { color: var(--muted); font-weight: 600; }
      h1 {
        margin: 0.4rem 0 0.15rem; font-size: clamp(1.6rem, 4vw, 2.3rem);
        font-weight: 800; letter-spacing: -0.02em; line-height: 1.05;
      }
      .tagline { margin: 0; color: var(--ink-2); font-size: 1rem; }
      .stats {
        margin: 0.7rem 0 0; font-size: 0.82rem; color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .stats .live { color: var(--accent); font-weight: 650; }

      /* `header` above is pointer-events: none so clicks reach the canvas —
         a link inside it has to take them back or it is dead on arrival. */
      .crosslink { margin: 0.5rem 0 0; }
      .crosslink a {
        pointer-events: auto;
        display: inline-block; font-size: 0.85rem; font-weight: 650;
        color: var(--accent); text-decoration: none;
        padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: 99px;
        background: var(--surface);
      }
      .crosslink a:hover { border-color: var(--accent); }

      #card {
        position: fixed; top: 1.4rem; right: 1.4rem; width: min(20rem, calc(100vw - 2.8rem));
        background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
        padding: 1.1rem 1.2rem; backdrop-filter: blur(8px);
        transform: translateX(calc(100% + 2rem)); transition: transform 0.25s ease;
      }
      #card.open { transform: none; }
      @media (prefers-reduced-motion: reduce) { #card { transition: none; } }
      #card h2 { margin: 0 2rem 0.3rem 0; font-size: 1.15rem; letter-spacing: -0.01em; }
      #card .meta { margin: 0; font-size: 0.85rem; color: var(--ink-2); }
      #card .counts { margin: 0.4rem 0 0.8rem; font-size: 0.82rem; color: var(--muted); }
      .chip {
        display: inline-block; padding: 0.1rem 0.55rem; border-radius: 99px;
        background: var(--accent); color: #fff; font-size: 0.75rem; font-weight: 650;
      }
      #card .links { display: grid; gap: 0.4rem; }
      #card .links a {
        display: block; padding: 0.5rem 0.75rem; border-radius: var(--radius); font-size: 0.88rem;
        text-decoration: none; color: var(--ink); border: 1px solid var(--line);
      }
      #card .links a.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 650; }
      #card .links a.hidden { display: none; }
      #card-close {
        position: absolute; top: 0.55rem; right: 0.7rem; border: 0; background: none;
        font-size: 1.3rem; line-height: 1; color: var(--muted); cursor: pointer; padding: 0.2rem;
      }

      footer {
        position: fixed; left: 1.6rem; right: 1.6rem; bottom: 1rem;
        display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem;
        pointer-events: none; flex-wrap: wrap;
      }
      .legend { list-style: none; display: flex; gap: 1.1rem; margin: 0; padding: 0; flex-wrap: wrap; }
      .legend li { font-size: 0.78rem; color: var(--muted); display: flex; align-items: center; gap: 0.4rem; }
      .dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; display: inline-block; }
      .dot.bud { background: var(--leaf-soft); border: 2px solid var(--bud); }
      .dot.blossom { background: var(--blossom); border: 2px solid var(--accent); }
      .dot.green { background: var(--leaf); }
      .dot.ripe { background: var(--accent); box-shadow: 0 0 8px var(--halo); }
      .credit { margin: 0; font-size: 0.78rem; color: var(--muted); }

      @media (max-width: var(--container)) {
        header { max-width: 14rem; }
        #card { top: auto; bottom: 4.6rem; right: 0.8rem; width: min(20rem, calc(100vw - 1.6rem)); }
        footer { bottom: 0.6rem; }
        .credit { display: none; }
      }
    </style>

    <script>
      import { createTree } from '../../lib/tree.js';
      import { startPolling, BLOOM_EVENTS } from '../../lib/data.js';
      import { DEFAULT_LOCALE, isLocale, t } from '../../lib/i18n';

      // Astro ships ONE bundle for every route, so the language is read from
      // the <html lang> the page rendered with.
      const htmlLang = document.documentElement.lang;
      const locale = isLocale(htmlLang) ? htmlLang : DEFAULT_LOCALE;
      const _ = (key: string, vars?: Record<string, string | number>) => t(locale, key, vars);

      const card = document.getElementById('card');
      const stats = document.getElementById('stats');
      const $ = (id) => document.getElementById(id);

      function showCard(p) {
        if (!p) { card.classList.remove('open'); return; }
        $('card-name').textContent = p.name;
        $('card-status').textContent = p.status ? _(`status.${p.status}`) : '';
        $('card-creator').textContent = _('card.planted', { creator: p.creator ?? 'brotea' });
        $('card-counts').textContent = [
          _('card.deployed', { count: p.deployed_features ?? 0 }),
          _('card.open', { count: p.open_features ?? 0 }),
        ].join(' · ');
        for (const [id, href] of [['card-url', p.url], ['card-repo', p.repo_url], ['card-topic', p.topic_url]]) {
          const a = $(id) as HTMLAnchorElement;
          if (href) { a.href = href; a.classList.remove('hidden'); } else { a.classList.add('hidden'); }
        }
        card.classList.add('open');
        history.replaceState(null, '', `#${p.slug}`);
      }
      document.getElementById('card-close').addEventListener('click', () => {
        showCard(null);
        tree.select(null);
        history.replaceState(null, '', location.pathname);
      });

      const tree = createTree(document.getElementById('tree'), { onSelect: showCard });

      function openFromHash() {
        const slug = location.hash.slice(1);
        const p = slug && current.find((x) => x.slug === slug);
        if (p) { tree.select(slug); showCard(p); }
      }
      addEventListener('hashchange', openFromHash);

      let current = [];
      startPolling({
        onSnapshot(projects, live) {
          current = projects;
          tree.setData(projects);
          const prod = projects.filter((p) => p.status === 'production').length;
          const summary = _('stats.summary', { projects: projects.length, prod });
          stats.innerHTML = live
            ? `${summary} · <span class="live">${_('stats.live')}</span>`
            : `${summary} · ${_('stats.offline')}`;
          // Deep link: brotea.dev/#slug opens that project's card.
          if (!card.classList.contains('open')) openFromHash();
        },
        onEvents(events) {
          events.forEach((e, i) => {
            if (!e.project) return;
            setTimeout(() => tree.pulse(e.project, BLOOM_EVENTS.has(e.event_type)), i * 700);
          });
        },
      });
    </script>
  </body>
</html>
